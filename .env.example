# ==============================================================================
# HACKATHON DEMO PROTOTYPE - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual API keys and endpoints:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Voice Services (ElevenLabs SDK - STT scribe_v1 & TTS eleven_v3)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: defaults to "21m00Tcm4TlvDq8ikWAM" (Rachel) if left unset
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 2. Public Base URL (Used for scannable QR Code and WhatsApp share links)
# ------------------------------------------------------------------------------
# Set to your live cloud deployment URL (e.g. https://your-app.awsapprunner.com or https://my-app.vercel.app)
PUBLIC_BASE_URL=https://your-public-app-url.com
SKILL_CARD_BASE_URL=https://your-public-app-url.com/verify

# ------------------------------------------------------------------------------
# 3. AI Extraction (Gemini AI - Owned by AI teammate)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Cloud Infrastructure & Storage (AWS - Owned by Backend / Cloud teammate)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_voice_cards_bucket_name
